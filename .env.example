# Copy to .env (never commit .env) or export these in your shell.

# Required. Create a key in the dashboard under Account -> API keys.
# Use mock-key with the mock server.
MOLOCHAI_API_KEY=your-api-key

# Optional. Defaults to the hosted API.
# Mock server: http://127.0.0.1:4010/api/v1
MOLOCHAI_BASE_URL=https://api.molochai.dev/api/v1

# Optional. Enables tests/test_integration_mock.py against a running mock server.
# MOLOCHAI_MOCK_BASE_URL=http://127.0.0.1:4010/api/v1
